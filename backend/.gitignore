```gitignore
# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example

# SQLite database files
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Editor settings
.vscode/
.idea/

# Build outputs
dist/
build/
coverage/

# Temporary files
tmp/
temp/
*.tmp

# Cache files
.npm/
.cache/
```
